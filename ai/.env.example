# ==============================================================================
# HandyGo AI Service - Environment Configuration
# ==============================================================================

AI_SERVICE_PORT=8000
DEBUG=false

# --- 1. Cloud Media Storage (Cloudinary) ---
# Toàn bộ ảnh selfie và chân dung cắt từ CCCD được lưu trữ an toàn trên Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=handy-go/identity_verifications
CLOUDINARY_DELIVERY_TYPE=upload
# Hoặc dùng định dạng URL đầy đủ:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- 2. Cloud Queue & Cache (Upstash Redis) ---
# Dùng để đẩy job bất đồng bộ giữa ai-service và ai-worker (có hỗ trợ TLS rediss://)
AI_REDIS_URL=rediss://default:<PASSWORD>@<UPSTASH_HOST>:6379
IDENTITY_JOB_INPUT_DIR=storage/identity_jobs
IDENTITY_JOB_TTL_SECONDS=86400

# --- 3. Cloud Message Broker (CloudAMQP RabbitMQ) ---
# Dùng để bắn sự kiện kết quả duyệt KYC (kyc.reviewing, kyc.failed) về Backend NestJS
RABBITMQ_URL=amqps://<USER>:<PASS>@<HOST>/<VHOST>
RABBITMQ_EXCHANGE=handy-go.events

# --- 4. Internal Security Keys ---
INTERNAL_SERVICE_SECRET=handy-go-internal-service-secret-key-12345
