# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

# API Configuration (HANDY GO Gateway / Backend)
# For Android Emulator use http://10.0.2.2:3000/api/v1; for physical device use your dev machine IP or USB reverse
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Map Provider API Key (Google Maps / OpenStreetMap)
# TODO: Replace with official Google Maps API key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Example / Feature Flags
EXPO_PUBLIC_VAR_NUMBER=10
EXPO_PUBLIC_VAR_BOOL=true

# Build-time only secrets (no EXPO_PUBLIC prefix - NOT accessible in src folder)
SECRET_KEY=your_build_secret_key_here
APP_BUILD_ONLY_VAR=build_only_value_placeholder
