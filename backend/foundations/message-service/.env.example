# Explicit local development settings only. No production credentials.
# From backend/: load with node --env-file=foundations/message-service/.env ...
MESSAGE_HOST=127.0.0.1
MESSAGE_PORT=3011
DATABASE_URL_MESSAGE=postgresql://message:local-password@127.0.0.1:5432/handygo?schema=message
DIRECT_URL_MESSAGE=postgresql://message:local-password@127.0.0.1:5432/handygo?schema=message
DB_POOL_MAX_MESSAGE=4
INTERNAL_SERVICE_SECRET=replace-with-the-same-local-internal-secret
MESSAGE_CURSOR_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_SERVICE_URL=http://127.0.0.1:3001
ORDER_SERVICE_URL=http://127.0.0.1:3004
BIDDING_SERVICE_URL=http://127.0.0.1:3005
MEDIA_SERVICE_URL=http://127.0.0.1:3000
RABBITMQ_URL=amqp://handygo:handygo@127.0.0.1:5672
RABBITMQ_EXCHANGE=handy-go.events
MESSAGE_EVENT_QUEUE=handygo.message.events.v1
CORS_ORIGIN=http://localhost:8081
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
