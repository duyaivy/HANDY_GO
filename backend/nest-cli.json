        "tsConfigPath": "libs/logger/tsconfig.lib.json"
      }
    },
    "matching-service": {
      "type": "application",
      "root": "apps/matching-service",
      "entryFile": "main",
      "sourceRoot": "apps/matching-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/matching-service/tsconfig.app.json"
      }
    },
    "notification-service": {
      "type": "application",
