# Copy to .env and fill values. Never commit .env.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_FOLDER=identity_verifications
CLOUDINARY_DELIVERY_TYPE=upload

# Protect Admin review endpoints.
ADMIN_API_KEY=change-this-to-a-long-random-secret

# Redis/Upstash for async identity verification queue (use rediss:// for TLS)
AI_REDIS_URL=rediss://default:<ROTATED_PASSWORD>@<UPSTASH_HOST>:6379
IDENTITY_JOB_INPUT_DIR=storage/identity_jobs
IDENTITY_JOB_TTL_SECONDS=86400
