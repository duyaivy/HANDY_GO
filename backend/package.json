{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build --all",
    "build:gateway": "nest build api-gateway",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prisma:generate:auth": "prisma generate --schema=apps/auth-service/prisma/schema.prisma",
    "prisma:generate:user-trust": "prisma generate --schema=apps/user-trust-service/prisma/schema.prisma",
    "prisma:generate": "pnpm run prisma:generate:auth && pnpm run prisma:generate:user-trust",
    "prisma:migrate:auth": "prisma migrate deploy --schema=apps/auth-service/prisma/schema.prisma --config=apps/auth-service/prisma/prisma.config.ts",
    "prisma:migrate:user-trust": "prisma migrate deploy --schema=apps/user-trust-service/prisma/schema.prisma --config=apps/user-trust-service/prisma/prisma.config.ts",
    "prisma:migrate": "pnpm run prisma:migrate:auth && pnpm run prisma:migrate:user-trust",
    "prisma:status:auth": "prisma migrate status --schema=apps/auth-service/prisma/schema.prisma --config=apps/auth-service/prisma/prisma.config.ts",
    "prisma:status:user-trust": "prisma migrate status --schema=apps/user-trust-service/prisma/schema.prisma --config=apps/user-trust-service/prisma/prisma.config.ts",
    "prisma:status": "pnpm run prisma:status:auth && pnpm run prisma:status:user-trust",
    "keys:generate": "node scripts/generate-jwt-keys.mjs",
    "db:setup": "pnpm run prisma:generate && pnpm run prisma:migrate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gateway/main.js",
    "lint": "oxlint apps/ libs/ *.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc -b --force --pretty false && tsc --noEmit -p tsconfig.prisma.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "libphonenumber-js": "^1.13.14",
    "http-proxy-middleware": "^4.2.0",
    "nestjs-pino": "^5.2.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.5",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "nodemon": "^3.1.14",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}