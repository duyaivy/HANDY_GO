{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@app/auth": ["./libs/auth/src/index.ts"],
      "@app/auth/*": ["./libs/auth/src/*"],
      "@app/common": ["./libs/common/src/index.ts"],
      "@app/common/*": ["./libs/common/src/*"],
      "@app/config": ["./libs/config/src/index.ts"],
      "@app/config/*": ["./libs/config/src/*"],
      "@app/database": ["./libs/database/src/index.ts"],
      "@app/database/*": ["./libs/database/src/*"],
      "@app/event-bus": ["./libs/event-bus/src/index.ts"],
      "@app/event-bus/*": ["./libs/event-bus/src/*"],
      "@app/logger": ["./libs/logger/src/index.ts"],
      "@app/logger/*": ["./libs/logger/src/*"],
      "@app/redis": ["./libs/redis/src/index.ts"],
      "@app/redis/*": ["./libs/redis/src/*"]
    }
  },
  "files": [],
  "references": [
    {
      "path": "./libs/auth/tsconfig.lib.json"
    },
    {
      "path": "./libs/common/tsconfig.lib.json"
    },
    {
      "path": "./libs/config/tsconfig.lib.json"
    },
    {
      "path": "./libs/database/tsconfig.lib.json"
    },
    {
      "path": "./libs/event-bus/tsconfig.lib.json"
    },
    {
      "path": "./libs/logger/tsconfig.lib.json"
    },
    {
      "path": "./libs/redis/tsconfig.lib.json"
    },
    {
      "path": "./apps/api-gateway/tsconfig.app.json"
    },
    {
      "path": "./apps/auth-service/tsconfig.app.json"
    },
    {
      "path": "./apps/catalog-service/tsconfig.app.json"
    },
    {
      "path": "./apps/order-service/tsconfig.app.json"
    },
    {
      "path": "./apps/bidding-service/tsconfig.app.json"
    },
    {
      "path": "./apps/matching-service/tsconfig.app.json"
    },
    {
      "path": "./apps/payment-service/tsconfig.app.json"
    },
    {
      "path": "./apps/notification-service/tsconfig.app.json"
    },
    {
      "path": "./apps/wallet-service/tsconfig.app.json"
    },
    {
      "path": "./apps/tracking-service/tsconfig.app.json"
    },
    {
      "path": "./apps/user-trust-service/tsconfig.app.json"
    }
  ]
}
