# Application
NODE_ENV=development
PORT=3001

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# OTP Configuration (REQUIRED secret, optional timers)
OTP_SECRET=replace-with-a-secure-random-otp-secret-at-least-32-chars
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Internal Gateway Secret (Shared secret between API Gateway and Auth Service for trusted forwarding)
INTERNAL_SERVICE_SECRET=replace-with-a-secure-random-internal-gateway-secret-at-least-32-chars

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://handygo:handygo@localhost:5672
RABBITMQ_EXCHANGE=handy-go.events
RABBITMQ_QUEUE=auth-service

# Logging
LOG_LEVEL=debug
