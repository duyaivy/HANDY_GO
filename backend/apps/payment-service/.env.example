# Export these in the service/deployment environment; this file is documentation only.
DATABASE_URL_PAYMENT=
# Controlled seed ONLY: no defaults, no startup seed. Verify an existing authorized actor externally.
COMMISSION_SEED_EFFECTIVE_FROM=
COMMISSION_SEED_ACTOR_ID=

PAYMENT_INBOUND_RETRY_ENABLED=true
PAYMENT_INBOUND_MAX_ATTEMPTS=8
PAYMENT_RECONCILER_ENABLED=true
PAYMENT_RECONCILER_INTERVAL_MS=15000

# Sandbox credentials from secret store. Missing config disables top-up creation.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Point to the implemented return endpoint THROUGH a verified Gateway route, or a real FE handler.
VNPAY_RETURN_URL=
# Merchant registration/deployment metadata; not read/registered by the adapter.
VNPAY_IPN_URL=

# Still blocked without a verified User Trust bank snapshot contract. Never enabled in production.
PAYOUT_MOCK_ENABLED=false
PAYOUT_MOCK_OUTCOME=succeeded
