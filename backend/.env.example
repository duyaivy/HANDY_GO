# ==============================================================================
# HANDY GO BACKEND — CENTRAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Tất cả microservices và Docker Compose sẽ đọc chung file cấu hình này.

# ==============================================================================
# PHẦN 1: CẤU HÌNH DÙNG CHUNG TOÀN HỆ THỐNG (SHARED INFRASTRUCTURE)
# ==============================================================================

# --- System Defaults ---
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000
UPSTREAM_TIMEOUT_MS=15000
LOG_LEVEL=debug

# --- Single Cloud Database Endpoint (Supabase / PostgreSQL) ---
# Dùng chung 1 DB Endpoint cho tất cả services (mỗi service tự tạo schema riêng)
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Shared Message Broker (RabbitMQ) ---
RABBITMQ_URL=amqp://handygo:handygo@localhost:5672
RABBITMQ_EXCHANGE=handy-go.events

# --- Shared Cache (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Shared Gateway Security & Authentication ---
INTERNAL_SERVICE_SECRET=replace-with-a-secure-random-internal-gateway-secret-at-least-32-chars
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_IMAGE_FOLDER=handy-go/images
CLOUDINARY_VIDEO_FOLDER=handy-go/videos
CLOUDINARY_IMAGE_MAX_SIZE_MB=10
CLOUDINARY_VIDEO_MAX_SIZE_MB=2048
CLOUDINARY_VIDEO_CHUNK_SIZE_MB=20



# ==============================================================================
# PHẦN 2: CẤU HÌNH CHI TIẾT THEO TỪNG MICROSERVICE
# ==============================================================================

# ------------------------------------------------------------------------------
# # API GATEWAY (Port: 3000)
# ------------------------------------------------------------------------------
PORT_API_GATEWAY=3000
AUTH_SERVICE_URL=http://localhost:3001
USER_TRUST_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
BIDDING_SERVICE_URL=http://localhost:3005
MATCHING_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
WALLET_SERVICE_URL=http://localhost:3009
TRACKING_SERVICE_URL=http://localhost:3010
RABBITMQ_QUEUE_GATEWAY=api-gateway

# ------------------------------------------------------------------------------
# # AUTH SERVICE (Port: 3001)
# ------------------------------------------------------------------------------
PORT_AUTH_SERVICE=3001
# (Tùy chọn) Override DB URL riêng nếu không dùng DATABASE_URL chung ở trên:
DATABASE_URL_AUTH=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?schema=auth_service
RABBITMQ_QUEUE_AUTH=auth-service

# OTP Security Parameters
OTP_SECRET=replace-with-a-secure-random-otp-secret-at-least-32-chars
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP Email Gateway
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="HANDY GO <noreply@handygo.vn>"
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ------------------------------------------------------------------------------
# # USER & TRUST SERVICE (Port: 3002)
# ------------------------------------------------------------------------------
PORT_USER_TRUST_SERVICE=3002
# (Tùy chọn) Override DB URL riêng nếu không dùng DATABASE_URL chung ở trên:
DATABASE_URL_USER_TRUST=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?schema=user_trust_service
RABBITMQ_QUEUE_USER_TRUST=user-trust-service

# ------------------------------------------------------------------------------
# # CATALOG SERVICE (Port: 3003)
# ------------------------------------------------------------------------------
PORT_CATALOG_SERVICE=3003
RABBITMQ_QUEUE_CATALOG=catalog-service

# ------------------------------------------------------------------------------
# # ORDER SERVICE (Port: 3004)
# ------------------------------------------------------------------------------
PORT_ORDER_SERVICE=3004
RABBITMQ_QUEUE_ORDER=order-service

# ------------------------------------------------------------------------------
# # BIDDING SERVICE (Port: 3005)
# ------------------------------------------------------------------------------
PORT_BIDDING_SERVICE=3005
RABBITMQ_QUEUE_BIDDING=bidding-service

# ------------------------------------------------------------------------------
# # MATCHING SERVICE (Port: 3006)
# ------------------------------------------------------------------------------
PORT_MATCHING_SERVICE=3006
RABBITMQ_QUEUE_MATCHING=matching-service

# ------------------------------------------------------------------------------
# # PAYMENT SERVICE (Port: 3007)
# ------------------------------------------------------------------------------
PORT_PAYMENT_SERVICE=3007
RABBITMQ_QUEUE_PAYMENT=payment-service

# ------------------------------------------------------------------------------
# # NOTIFICATION SERVICE (Port: 3008)
# ------------------------------------------------------------------------------
PORT_NOTIFICATION_SERVICE=3008
RABBITMQ_QUEUE_NOTIFICATION=notification-service

# ------------------------------------------------------------------------------
# # WALLET SERVICE (Port: 3009)
# ------------------------------------------------------------------------------
PORT_WALLET_SERVICE=3009
RABBITMQ_QUEUE_WALLET=wallet-service

# ------------------------------------------------------------------------------
# # TRACKING SERVICE (Port: 3010)
# ------------------------------------------------------------------------------
PORT_TRACKING_SERVICE=3010
RABBITMQ_QUEUE_TRACKING=tracking-service

