# ==============================================================================
# HANDY GO BACKEND — CENTRAL ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Sao chép file này thành `.env` ở thư mục gốc backend/ và tùy chỉnh các thông số.
# Tất cả microservices và Docker Compose sẽ tự động đọc chung file cấu hình này.

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM DEFAULTS
# ------------------------------------------------------------------------------
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
UPSTREAM_TIMEOUT_MS=15000
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. SINGLE POSTGRESQL DATABASE ENDPOINT (SUPABASE / CLOUD)
# ------------------------------------------------------------------------------
# Chỉ cần điền 1 DATABASE_URL duy nhất cho toàn hệ thống.
# Mỗi microservice sẽ tự động tạo/truy cập schema tương ứng (auth_service, user_trust_service...).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# Cấu hình đường dẫn DB riêng dạng OPTIONAL (chỉ điền nếu muốn override tên schema hoặc đùng DB khác):
DATABASE_URL_AUTH=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?schema=auth_service
DATABASE_URL_USER_TRUST=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?schema=user_trust_service

# ------------------------------------------------------------------------------
# 3. MESSAGE BROKER & CACHE (RABBITMQ & REDIS)
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://handygo:handygo@localhost:5672
RABBITMQ_EXCHANGE=handy-go.events

REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. SECURITY & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Mã bí mật xác thực nội bộ giữa API Gateway và các Microservices (tối thiểu 32 ký tự)
INTERNAL_SERVICE_SECRET=replace-with-a-secure-random-internal-gateway-secret-at-least-32-chars

# Đường dẫn khóa RSA RS256 ký và xác thực JWT (tạo bằng: `pnpm run keys:generate`)
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# ------------------------------------------------------------------------------
# 5. AUTH SERVICE & OTP / EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
OTP_SECRET=replace-with-a-secure-random-otp-secret-at-least-32-chars
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# SMTP Email Gateway (Cloud SMTP / SendGrid / Resend / Mailgun...)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM="HANDY GO <noreply@handygo.vn>"
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# ------------------------------------------------------------------------------
# 6. API GATEWAY UPSTREAM SERVICE ROUTING URLS
# ------------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3001
USER_TRUST_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
ORDER_SERVICE_URL=http://localhost:3004
BIDDING_SERVICE_URL=http://localhost:3005
MATCHING_SERVICE_URL=http://localhost:3006
PAYMENT_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
WALLET_SERVICE_URL=http://localhost:3009
TRACKING_SERVICE_URL=http://localhost:3010
