# Application
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:5173
UPSTREAM_TIMEOUT_MS=3000

# Auth Service Database (PostgreSQL - host port 5432 in docker-compose)
DATABASE_URL_AUTH=postgresql://postgres:postgres@localhost:5432/handy_auth

# User & Trust Service Database (PostgreSQL - host port 5433 in docker-compose)
DATABASE_URL_USER_TRUST=postgresql://postgres:postgres@localhost:5433/handy_user_trust

# RabbitMQ
RABBITMQ_URL=amqp://handygo:handygo@localhost:5672
RABBITMQ_EXCHANGE=handy-go.events

# SMTP Configuration (Gmail SMTP with App Password)
# Hướng dẫn tạo App Password: https://support.google.com/accounts/answer/185833
# Cấu hình Gmail SMTP: https://support.google.com/a/answer/176600
# Lưu ý: Bật xác thực 2 bước (2FA) trên tài khoản Google, tạo Mật khẩu ứng dụng (App Password) 16 ký tự.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM="HANDY GO <your-email@gmail.com>"
SMTP_USER=your-email@gmail.com
SMTP_PASS="xxxx xxxx xxxx xxxx"

# OTP Configuration (HMAC-SHA256 server-side key for OTP hashing, minimum 32 random characters)
OTP_SECRET=replace-with-a-secure-random-otp-secret-at-least-32-chars
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Internal Gateway Secret (Shared secret between API Gateway and internal services, minimum 32 random characters)
INTERNAL_SERVICE_SECRET=replace-with-a-secure-random-internal-gateway-secret-at-least-32-chars

# JWT RS256 Key Paths (Generate using `pnpm run keys:generate`)
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# Redis
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
