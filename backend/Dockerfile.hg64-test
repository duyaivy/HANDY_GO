FROM node:24-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /app

RUN apt-get update && apt-get install --yes --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable \
  && corepack prepare pnpm@10.17.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN DATABASE_URL_MESSAGE='postgresql://ci:ci@127.0.0.1:5432/prisma_generate?schema=message' pnpm run prisma:generate \
  && pnpm exec nest build api-gateway \
  && pnpm exec nest build order-service \
  && pnpm exec nest build tracking-service
