# ==============================================================================
# HANDY GO BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Giữ đủ PORT_*/RABBITMQ_QUEUE_* theo backend/.env.example để đối chiếu từng service.
# PORT thực tế do Compose đặt; PORT_* và RABBITMQ_QUEUE_* hiện chỉ là thông tin
# tham chiếu, source chưa đọc để thay đổi cổng hoặc queue. Xem README mục 6.
# Format raw: KEY=value; không quote, không inline comment.
# Chỉ DATABASE_URL_AUTH / DATABASE_URL_USER_TRUST / DATABASE_URL_CATALOG được để rỗng hoặc bỏ qua.

# ==============================================================================
# PHẦN 1: CẤU HÌNH DÙNG CHUNG TOÀN HỆ THỐNG (SHARED INFRASTRUCTURE)
# ==============================================================================

# --- System Defaults ---
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=https://app.example.com
UPSTREAM_TIMEOUT_MS=15000
LOG_LEVEL=info

# --- API Gateway reverse proxy ---
# IP nội bộ container Nginx cố định trong compose.production.yml.
# Không thay bằng IP public hoặc WireGuard của VPS.
TRUSTED_PROXY_CIDRS=172.30.1.10/32

# --- Single Cloud Database Endpoint (Supabase / PostgreSQL) ---
# DATABASE_URL là bắt buộc và dùng chung cho Catalog, Auth, User Trust.
# Auth / User Trust có thể override bằng URL riêng tại mục service bên dưới.
# Endpoint phải hỗ trợ TLS và migration DDL; không dùng localhost trong container.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?sslmode=verify-full

# --- Shared Message Broker (RabbitMQ) ---
RABBITMQ_URL=amqps://USER:PASSWORD@BROKER_HOST:5671/VHOST
RABBITMQ_EXCHANGE=handy-go.events

# --- Shared Cache (Redis) ---
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379

# --- SMTP Configuration (Gmail SMTP with App Password) ---
# Dùng App Password thật; SMTP chỉ khai báo ở đây, không lặp lại trong Auth.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=HANDY GO <your-email@gmail.com>
SMTP_USER=your-email@gmail.com
SMTP_PASS=REPLACE_APP_PASSWORD

# --- Shared Gateway Security & Authentication ---
INTERNAL_SERVICE_SECRET=REPLACE_RANDOM_64_HEX
# Production truyền nội dung PEM dạng base64:, không dùng đường dẫn key local.
JWT_PRIVATE_KEY=base64:REPLACE_BASE64_PRIVATE_PEM
JWT_PUBLIC_KEY=base64:REPLACE_BASE64_PUBLIC_PEM
# Thời hạn access token tính bằng giây: 300 = 5 phút; không ghi "5m".
ACCESS_TOKEN_EXPIRATION_SECONDS=300

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=REPLACE_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_API_KEY
CLOUDINARY_API_SECRET=REPLACE_API_SECRET
CLOUDINARY_IMAGE_FOLDER=handy-go/images
CLOUDINARY_VIDEO_FOLDER=handy-go/videos
CLOUDINARY_IMAGE_MAX_SIZE_MB=10
CLOUDINARY_VIDEO_MAX_SIZE_MB=2048
CLOUDINARY_VIDEO_CHUNK_SIZE_MB=20

# ==============================================================================
# PHẦN 2: CẤU HÌNH CHI TIẾT THEO TỪNG MICROSERVICE
# ==============================================================================

# ------------------------------------------------------------------------------
# API GATEWAY (Port: 3000 | VPS1)
# ------------------------------------------------------------------------------
PORT_API_GATEWAY=3000
# Cùng VPS1: dùng Docker service name. Khác VPS: dùng IP WireGuard của máy đó.
AUTH_SERVICE_URL=http://auth-service:3001
USER_TRUST_SERVICE_URL=http://user-trust-service:3002
CATALOG_SERVICE_URL=http://10.77.0.3:3003
ORDER_SERVICE_URL=http://10.77.0.2:3004
BIDDING_SERVICE_URL=http://10.77.0.2:3005
MATCHING_SERVICE_URL=http://10.77.0.2:3006
PAYMENT_SERVICE_URL=http://10.77.0.3:3007
NOTIFICATION_SERVICE_URL=http://notification-service:3008
WALLET_SERVICE_URL=http://10.77.0.3:3009
TRACKING_SERVICE_URL=http://10.77.0.2:3010
RABBITMQ_QUEUE_GATEWAY=api-gateway

# ------------------------------------------------------------------------------
# AUTH SERVICE (Port: 3001 | VPS1)
# ------------------------------------------------------------------------------
PORT_AUTH_SERVICE=3001
# Tùy chọn; bỏ qua hoặc để rỗng để dùng DATABASE_URL chung (schema mặc định auth_service).
# DATABASE_URL_AUTH=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?schema=auth_service&sslmode=verify-full
RABBITMQ_QUEUE_AUTH=auth-service

# OTP Security Parameters
# OTP_SECRET phải khác INTERNAL_SERVICE_SECRET và dài ít nhất 32 ký tự.
OTP_SECRET=REPLACE_DIFFERENT_RANDOM_64_HEX
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# SMTP và cấu hình JWT/access token dùng các biến chung ở PHẦN 1.

# ------------------------------------------------------------------------------
# USER & TRUST SERVICE (Port: 3002 | VPS1)
# ------------------------------------------------------------------------------
PORT_USER_TRUST_SERVICE=3002
# Tùy chọn; bỏ qua hoặc để rỗng để dùng DATABASE_URL chung (schema mặc định user_trust_service).
# DATABASE_URL_USER_TRUST=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?schema=user_trust_service&sslmode=verify-full
RABBITMQ_QUEUE_USER_TRUST=user-trust-service

# ------------------------------------------------------------------------------
# CATALOG SERVICE (Port: 3003 | VPS3)
# ------------------------------------------------------------------------------
PORT_CATALOG_SERVICE=3003
# Dùng DATABASE_URL, REDIS_URL và RabbitMQ chung ở PHẦN 1.
# DATABASE_URL_CATALOG là tùy chọn, chỉ để đối chiếu ENV; runtime/migration vẫn đọc DATABASE_URL.
# Muốn đổi DB Catalog đang dùng, sửa DATABASE_URL ở PHẦN 1.
# DATABASE_URL_CATALOG=postgresql://USER:PASSWORD@DB_HOST:5432/postgres?schema=catalog_service&sslmode=verify-full
RABBITMQ_QUEUE_CATALOG=catalog-service
# Thêm ENV riêng tại đây khi mở rộng service.

# ------------------------------------------------------------------------------
# ORDER SERVICE (Port: 3004 | VPS2)
# ------------------------------------------------------------------------------
PORT_ORDER_SERVICE=3004
RABBITMQ_QUEUE_ORDER=order-service
# Hiện health-only; thêm ENV riêng tại đây khi source sử dụng.

# ------------------------------------------------------------------------------
# BIDDING SERVICE (Port: 3005 | VPS2)
# ------------------------------------------------------------------------------
PORT_BIDDING_SERVICE=3005
RABBITMQ_QUEUE_BIDDING=bidding-service
# (Tùy chọn) DATABASE_URL_BIDDING=postgresql://.../postgres?schema=bidding_service
# (Tùy chọn) BID_REVISION_COOLDOWN_MS=120000

# ------------------------------------------------------------------------------
# MATCHING SERVICE (Port: 3006 | VPS2)
# ------------------------------------------------------------------------------
PORT_MATCHING_SERVICE=3006
RABBITMQ_QUEUE_MATCHING=matching-service
# Hiện health-only; thêm ENV riêng tại đây khi source sử dụng.

# ------------------------------------------------------------------------------
# PAYMENT SERVICE (Port: 3007 | VPS3)
# ------------------------------------------------------------------------------
PORT_PAYMENT_SERVICE=3007
RABBITMQ_QUEUE_PAYMENT=payment-service
# Hiện health-only; thêm ENV riêng tại đây khi source sử dụng.

# ------------------------------------------------------------------------------
# NOTIFICATION SERVICE (Port: 3008 | VPS1)
# ------------------------------------------------------------------------------
PORT_NOTIFICATION_SERVICE=3008
RABBITMQ_QUEUE_NOTIFICATION=notification-service
PUSH_ENABLED=false
PUSH_WORKER_ENABLED=true
PUSH_WORKER_POLL_INTERVAL_MS=3000
PUSH_WORKER_BATCH_SIZE=50
PUSH_WORKER_CONCURRENCY=10
PUSH_MAX_RETRY_ATTEMPTS=5
PUSH_WORKER_LEASE_TIMEOUT_MS=120000
FIREBASE_PROJECT_ID=handygo
# Chuỗi Base64 của Service Account JSON (dùng khi deploy qua GitHub Secrets / BACKEND_PRODUCTION_ENV):
FIREBASE_SA_BASE64=REPLACE_FIREBASE_SA_BASE64
GOOGLE_APPLICATION_CREDENTIALS=/opt/handygo/secrets/firebase-sa.json
# Chính sách thông báo In-app cho Production
NOTIFICATION_EVENT_POLICIES={"events":{"matching.eligible_workers.ready":{"mode":"optional","roles":["worker"]},"bid.submitted":{"mode":"optional","roles":["customer"]},"bid.revised":{"mode":"optional","roles":["customer"]},"booking_proposal.created":{"mode":"mandatory","roles":["worker"]},"booking_proposal.changes_requested":{"mode":"mandatory","roles":["customer"]},"booking_proposal.rejected":{"mode":"mandatory","roles":["customer"]},"order.created":{"mode":"mandatory","roles":["customer","worker"]},"order.cancelled":{"mode":"mandatory","roles":["customer","worker"]},"order.completed":{"mode":"mandatory","roles":["customer","worker"]},"payment.succeeded":{"mode":"mandatory","roles":["payer"]},"payment.failed":{"mode":"mandatory","roles":["payer"]},"payment.refunded":{"mode":"mandatory","roles":["recipient"]},"wallet.credited":{"mode":"mandatory","roles":["owner"]},"wallet.debited":{"mode":"mandatory","roles":["owner"]},"wallet.balance.adjusted":{"mode":"mandatory","roles":["owner"]}},"transitions":{"confirmed->in_progress":{"mode":"mandatory","roles":["customer"],"template":{"title":"Công việc đã bắt đầu","body":"Thợ đã bắt đầu thực hiện công việc của bạn."}},"in_progress->awaiting_customer_confirmation":{"mode":"mandatory","roles":["customer"],"template":{"title":"Cần xác nhận hoàn thành","body":"Thợ đã báo hoàn thành. Vui lòng kiểm tra và xác nhận công việc."}},"awaiting_customer_confirmation->in_progress":{"mode":"mandatory","roles":["worker"],"template":{"title":"Công việc cần xử lý lại","body":"Khách hàng yêu cầu kiểm tra hoặc thực hiện lại công việc."}},"in_progress->disputed":{"mode":"mandatory","roles":["customer","worker"],"template":{"title":"Đơn hàng đang tranh chấp","body":"Đơn hàng của bạn đang trong quá trình giải quyết tranh chấp."}},"awaiting_customer_confirmation->disputed":{"mode":"mandatory","roles":["customer","worker"],"template":{"title":"Đơn hàng đang tranh chấp","body":"Đơn hàng của bạn đang trong quá trình giải quyết tranh chấp."}},"disputed->in_progress":{"mode":"mandatory","roles":["customer","worker"],"template":{"title":"Tranh chấp đã được xử lý","body":"Công việc đã trở lại trạng thái đang thực hiện."}},"disputed->awaiting_customer_confirmation":{"mode":"mandatory","roles":["customer","worker"],"template":{"title":"Tranh chấp đã được xử lý","body":"Đơn hàng đang chờ khách hàng xác nhận hoàn thành."}}}}

# Chính sách thông báo Push FCM cho Production
PUSH_EVENT_POLICIES={"order.status.changed":{"enabled":true,"mode":"mandatory"},"matching.eligible_workers.ready":{"enabled":true,"mode":"optional"},"bid.submitted":{"enabled":true,"mode":"optional"},"bid.revised":{"enabled":true,"mode":"optional"},"booking_proposal.created":{"enabled":true,"mode":"mandatory"},"booking_proposal.changes_requested":{"enabled":true,"mode":"mandatory"},"booking_proposal.rejected":{"enabled":true,"mode":"mandatory"},"order.created":{"enabled":true,"mode":"mandatory"},"order.cancelled":{"enabled":true,"mode":"mandatory"},"order.completed":{"enabled":true,"mode":"mandatory"},"payment.succeeded":{"enabled":true,"mode":"mandatory"},"payment.failed":{"enabled":true,"mode":"mandatory"},"payment.refunded":{"enabled":true,"mode":"mandatory"},"wallet.credited":{"enabled":true,"mode":"mandatory"},"wallet.debited":{"enabled":true,"mode":"mandatory"},"wallet.balance.adjusted":{"enabled":true,"mode":"mandatory"}}


# ------------------------------------------------------------------------------
# WALLET SERVICE (Port: 3009 | VPS3)
# ------------------------------------------------------------------------------
PORT_WALLET_SERVICE=3009
RABBITMQ_QUEUE_WALLET=wallet-service
# Hiện health-only; thêm ENV riêng tại đây khi source sử dụng.

# ------------------------------------------------------------------------------
# TRACKING SERVICE (Port: 3010 | VPS2)
# ------------------------------------------------------------------------------
PORT_TRACKING_SERVICE=3010
RABBITMQ_QUEUE_TRACKING=tracking-service
# Hiện health-only; thêm ENV riêng tại đây khi source sử dụng.
